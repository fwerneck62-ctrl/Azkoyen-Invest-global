# ==============================================================================
# AZKOYEN INVEST — Production Environment Configuration
# ==============================================================================

# Server Port & Runtime Mode
PORT=3000
NODE_ENV=production

# Public Application URL (used for CORS defaults, links & callbacks)
APP_URL="MY_APP_URL"

# SQLite Persistent Database File Path (mount persistent storage volume here in prod)
DATABASE_PATH="./data/azkoye.db"

# Security Keys (REQUIRED in production — generate 64-char random hex strings)
# Example: openssl rand -hex 32
SESSION_SECRET=
VAULT_ENCRYPTION_KEY=

# Admin Bootstrap Passcode (optional gate for first-run Super Admin setup at /#/admin)
ADMIN_BOOTSTRAP_PASSCODE=

# Comma-separated allowed CORS origins for production reverse proxies / custom domains
# Example: https://app.azkoyeninvest.com,https://azkoyeninvest.com
ALLOWED_ORIGINS=

# Self-Trading Timed Options Defaults (7000 bps = 70% return)
SELF_TRADING_PAYOUT_BPS=7000

# Optional AI Integration Secret
GEMINI_API_KEY="MY_GEMINI_API_KEY"
